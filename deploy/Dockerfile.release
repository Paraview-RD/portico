# Release image. GoReleaser has already cross-compiled the binary — with the
# frontend embedded — so there is nothing to build here, only to package.
#
# deploy/Dockerfile is the one that builds from source; use that for a local
# `docker build` and for docker-compose.
FROM alpine:3 AS certs

FROM scratch

# GoReleaser lays the build context out as <os>/<arch>/portico, so the copy
# has to be platform-aware for the multi-platform build to pick the right one.
ARG TARGETPLATFORM

# Run unprivileged. scratch has no user database, so this is a bare uid:gid
# (nobody); the /data volume below is writable by it.
USER 65534:65534

# Root certificates: webhook delivery is outbound TLS, and scratch has no
# CA store. GoReleaser's build context has no /etc/ssl to copy from, so the
# bundle comes from a public image rather than from the builder.
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

COPY $TARGETPLATFORM/portico /portico

# No volume: state lives in PostgreSQL, so the container is disposable.
ENV PORTICO_ADDR=:8410

EXPOSE 8410

# Same check as deploy/Dockerfile, and it matters more here: this is the
# image published to a registry and the one people actually run. The image
# has no shell, so the check has to be something it already contains, which
# is this binary and nothing else — `portico ready` asks the running
# instance whether it can reach its database and exits 0 or 1.
#
# start-period is generous because the first start applies migrations, and a
# container reported unhealthy while it is legitimately still starting gets
# killed and restarted into the same delay.
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=3 \
    CMD ["/portico", "ready"]

ENTRYPOINT ["/portico"]

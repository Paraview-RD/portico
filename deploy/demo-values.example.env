# What has to be re-entered every time the public demo is rebuilt.
#
# The database is on Neon, which does not expire, so a rebuild is no longer a
# monthly event — it is a lost Render service, a region change, or a new
# fork. Rare is exactly when nobody remembers what went in, and each apply
# asks for the values Render cannot know. This file is the list of them.
#
# ---------------------------------------------------------------------------
# This is a template. The filled-in copy is not in this repository.
#
#   cp deploy/demo-values.example.env ~/.portico/demo-values.env
#   chmod 600 ~/.portico/demo-values.env
#
# Outside the working tree rather than gitignored inside it. A gitignore rule
# is one `git add -f`, one tool that does not read gitignore, and one careless
# edit to that file away from failing — and this repository's own .gitignore
# carries two entries that exist because exactly that happened. Nothing git
# does can reach a path it was never pointed at.
#
# The secrets below want a password manager as their real home; a laptop is
# not a backup. Keep this file as the convenience copy and the checklist,
# not as the only copy.
# ---------------------------------------------------------------------------

# --- Asked for at every `Apply Blueprint` ----------------------------------
# These are the render.yaml keys marked `sync: false`. A test holds this list
# against that file, so a new prompt cannot appear without appearing here.

# Neon's direct connection string: Connect, with Connection pooling off — no
# `-pooler` in the hostname — and the `sslmode=require` it comes with kept.
# The password inside it makes this a secret. The Neon project is in AWS Asia
# Pacific (Singapore), beside the service.
PORTICO_DB_DSN=

# 32 bytes as 64 hexadecimal characters: openssl rand -hex 32
# It seals directory bind passwords and webhook headers. A new one on an
# existing database leaves those unopenable, so it goes with the database:
# rebuild the service against the same Neon project and this must be the same
# value; start a fresh project and it can be new.
PORTICO_ENCRYPTION_KEY=

# The password the `admin` account is created with, on the first start against
# an empty database. There is no later: the service is reachable from the
# moment it deploys. Left unset, the account gets the default published in
# docs/access-guide.md, and the first stranger who read it is handed the
# change-password prompt.
PORTICO_INITIAL_ADMIN_PASSWORD=

# The address this deployment answers on — the custom domain once there is
# one. Every link the server writes into an email is built from it, as are
# OpenID Connect redirects and SAML metadata, so a wrong value gives a console
# that works perfectly and mail whose links lead nowhere.
PORTICO_PUBLIC_URL=

# --- Set in the dashboard, not in the Blueprint -----------------------------
# Deliberately absent from render.yaml: trials refuse every request without a
# relay, so the switch and the relay are turned on together, by hand, after
# the sending domain is verified.

PORTICO_MAIL_TRANSPORT=resend
# A send-only key. Generate a fresh one per deployment rather than reusing an
# older one: a key with one home can be accounted for, and a key that has been
# through a chat window or a screenshot cannot.
PORTICO_RESEND_API_KEY=
# Must be on the domain verified with the provider. A sender on any other
# domain is refused by the provider, not by Portico.
PORTICO_MAIL_FROM=

# --- The three switches ----------------------------------------------------
# Answered at sync time. Recorded here because "which of these was on" is not
# something to reconstruct from memory a month later.

PORTICO_TRIAL_SIGNUP=
PORTICO_LANDING_PAGE=
PORTICO_TENANT_CONSOLE=

# --- Facts about the deployment itself -------------------------------------
# Not secrets, and the reason this file is worth having even if the secrets
# live in a password manager: none of it is derivable from the repository.

# Render appends a suffix when the service name in render.yaml is taken, so
# the address is not predictable — read it off the service page.
DEMO_RENDER_SERVICE=
DEMO_RENDER_URL=
DEMO_CUSTOM_DOMAIN=
# A Render service cannot be moved out of its region once created. The Neon
# project should sit in the matching AWS region; it does not have to, but a
# far one is a round trip added to every query.
DEMO_REGION=
# Which Neon project and account hold the data, since the Render dashboard no
# longer shows a database next to the service.
DEMO_NEON_PROJECT=

# --- GitHub Actions --------------------------------------------------------
# One line, and it is a repository *variable* rather than a secret: the
# keepalive workflow reads it and silently does nothing when it is unset,
# which looks exactly like running.
#
# Four secrets used to live here — DEMO_DATABASE_URL, DEMO_SEED_PASSWORD,
# DEMO_ENCRYPTION_KEY, DEMO_JWT_SECRET — for a nightly workflow that emptied
# the schema and seeded it again. That workflow is gone: a trial tenant now
# carries its own deadline, so what had to be swept up expires per tenant
# instead of everything being replaced at three in the morning. If you find
# those names in an older copy of this file, they have nothing to set.

DEMO_URL=

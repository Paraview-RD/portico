# The collision. Same username as the tenant's own administrator, a different
# person, and not this directory's to touch.
dn: uid=admin,ou=support,ou=people,dc=example,dc=org
objectClass: inetOrgPerson
uid: admin
cn: Adam Minshull
sn: Minshull
displayName: Adam Minshull
mail: adam.minshull@example.org

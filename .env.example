# Copy to .env and adjust. Every setting has a working default except the
# JWT secret, which you should set explicitly in any real deployment.

# Address the HTTP server listens on.
KEYLITE_ADDR=:8410

# Storage. Only "sqlite" is implemented; the DSN is a file path.
KEYLITE_DB_DRIVER=sqlite
KEYLITE_DB_DSN=keylite.db

# Signs access tokens. Must be at least 32 bytes — the server refuses to
# start with a shorter one, because HS256 with a weak key can be brute-forced
# offline from a single captured token. If unset entirely, a random secret is
# generated at startup and every session is invalidated on restart.
# Generate one with:
#   openssl rand -hex 32
KEYLITE_JWT_SECRET=

# Trust X-Forwarded-For and X-Real-Ip for the client address recorded in the
# audit log. Leave this off unless a reverse proxy you control is guaranteed
# to be in front — otherwise any caller can forge the IP attributed to their
# own actions.
KEYLITE_TRUST_PROXY_HEADERS=false

# Default token lifetime. Accepts a Go duration ("2h", "30m") or a number of
# seconds. This is only the starting value — it is adjustable at runtime from
# the settings screen once the instance is running.
KEYLITE_TOKEN_TTL=2h

# The bootstrap administrator, created only when the database has no users.
# Leave the password empty to have one generated and printed once at startup.
KEYLITE_INITIAL_ADMIN_USERNAME=admin
KEYLITE_INITIAL_ADMIN_PASSWORD=

# debug | info | warn | error
KEYLITE_LOG_LEVEL=info

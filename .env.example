# Copy to .env and adjust. Every setting has a working default except
# PORTICO_DB_DSN, which has none — without it the server says so and exits.
# The JWT secret does not stop a start, and you should still set it
# explicitly in any real deployment: unset, a random one is generated and
# every session dies on restart.

# Address the HTTP server listens on.
PORTICO_ADDR=:8410

# Storage. Only "postgres" is implemented. The DSN is required — there is no
# sensible default for someone else's database.
#
# 5443 rather than PostgreSQL's own 5432, and the number is deliberate: 5432
# is usually already taken on a machine that runs more than one project, and
# connecting to the wrong database is a failure that looks like a working
# server with somebody else's data in it. deploy/docker-compose.yml offers
# 5443 as the host mapping for the same reason — that commented-out line is
# where this number comes from.
#
# CI is the exception and uses 5432, because a service container in a fresh
# runner has nothing to collide with.
PORTICO_DB_DRIVER=postgres
PORTICO_DB_DSN=postgres://portico:portico@localhost:5443/portico?sslmode=disable

# Signs access tokens. Must be at least 32 bytes — the server refuses to
# start with a shorter one, because HS256 with a weak key can be brute-forced
# offline from a single captured token. If unset entirely, a random secret is
# generated at startup and every session is invalidated on restart.
# Generate one with:
#   openssl rand -hex 32
PORTICO_JWT_SECRET=

# Prometheus metrics, on a listener of their own. Empty (the default)
# publishes nothing at all.
#
# This endpoint is NOT authenticated — no Prometheus deployment
# authenticates — so bind it to an address only your monitoring can reach,
# and never publish this port through the proxy that serves the application.
# PORTICO_METRICS_ADDR=127.0.0.1:9410

# Protects the few credentials Portico has to store and later use, rather than
# merely verify: a directory connector's bind password, and the header values
# a webhook subscription sends. 32 bytes of hex; generate with:
#   openssl rand -hex 32
#
# Leaving it unset starts normally. What it does is make saving such a
# credential fail, with the reason, instead of writing it in the clear. It must
# not be the same value as PORTICO_JWT_SECRET: those protect different things
# and leak through different accidents, and one value doing both jobs means
# either leak costs both.
# PORTICO_ENCRYPTION_KEY=

# Trust X-Forwarded-For and X-Real-Ip for the client address recorded in the
# audit log. Leave this off unless a reverse proxy you control is guaranteed
# to be in front — otherwise any caller can forge the IP attributed to their
# own actions.
PORTICO_TRUST_PROXY_HEADERS=false

# Self-service trials: let somebody with no account create a tenant by proving
# an email address. Off, and it must stay off anywhere holding real staff.
#
# These are the only writes in this API a stranger can reach, and the only ones
# that create a tenant — which is otherwise deliberately a command-line job,
# because no cross-tenant role exists for an API to authorize. Turning this on
# is declaring the deployment a demonstration.
#
# What a signed-out visitor sees at the root address.
#
# Off, and the root address sends them to the sign-in form — which is right
# where everybody arriving already has an account, and where a page explaining
# what Portico is would be a click between them and their work.
#
# On, the root address is a page that says what this is, with the sign-in form
# one click away. For a public address a stranger reaches with no idea what
# they have opened; there the sign-in form asks for something they do not have.
PORTICO_LANDING_PAGE=false

# Needs SMTP below: the email address is the only thing being proven.
PORTICO_TRIAL_SIGNUP=false
# How many trial tenants may exist at once. Reached, the form says so.
PORTICO_TRIAL_MAX_TENANTS=50
# Mailbox providers refused for a trial signup, comma-separated. Added to the
# throwaway-address list the server ships with rather than replacing it.
#
# The rest of the limits are not settings: one tenant per mailbox, three links
# a day to any one mailbox, five requests a day from one client, thirty an
# hour across the whole deployment. See docs/access-guide.md.
PORTICO_TRIAL_BLOCKED_EMAIL_DOMAINS=

# How many sign-in requests one client address may make per minute, and how
# many of that allowance may arrive at once. Applies to the writes under
# /api/v1/auth/ — the endpoints reachable without a credential that cost a
# password hash, an email, or a row. The two reads there are what the sign-in
# screen asks on every load, and they are not counted.
#
# This is a floor, not a throttle: it counts per address and per process, so
# an attacker with many addresses is unaffected and a corporate NAT shares one
# allowance. Both are the reverse proxy's job, and the proxy is still the
# right place for the real limit — see docs/access-guide.md. What this stops
# is an instance with nothing in front of it being unprotected by default.
#
# 0 turns it off. Per-account lockout is a separate control, configured at
# runtime from the settings screen.
PORTICO_AUTH_RATE_LIMIT=60
PORTICO_AUTH_RATE_LIMIT_BURST=30

# Default token lifetime. Accepts a Go duration ("2h", "30m") or a number of
# seconds. This is only the starting value — it is adjustable at runtime from
# the settings screen once the instance is running.
PORTICO_TOKEN_TTL=2h

# The bootstrap administrator, created only when the database has no users.
# Leave the password empty and the account starts on the documented default,
# Portico@1, which sign-in refuses until it is replaced — the first attempt
# answers PASSWORD_CHANGE_REQUIRED and the screen asks for a new one. Set a
# password here instead and that forced change does not apply.
PORTICO_INITIAL_ADMIN_USERNAME=admin
PORTICO_INITIAL_ADMIN_PASSWORD=

# Where people reach this deployment. Two things depend on it: the links in
# password-recovery messages, and the OpenID Connect issuer identifier that
# appears in every token and is what relying parties verify against.
# It cannot be derived from a request: behind a proxy the Host header is
# whatever that proxy sends, so both would follow wherever the caller asked.
# Changing it after applications have been integrated invalidates their
# configuration, because the issuer is part of it.
PORTICO_PUBLIC_URL=http://localhost:8410

# Mail relay for password recovery. Leave the host empty and email recovery
# reports itself unavailable rather than accepting requests it cannot fulfil.
# Any SMTP server works — a company relay, a hosted provider, or a local
# catcher such as Mailpit while developing.
PORTICO_SMTP_HOST=
PORTICO_SMTP_PORT=587
PORTICO_SMTP_USERNAME=
PORTICO_SMTP_PASSWORD=
PORTICO_SMTP_FROM=
# starttls (default, required not opportunistic) | tls (implicit, usually
# port 465) | none (only for a relay on a network you control)
PORTICO_SMTP_ENCRYPTION=starttls

# Which transport carries the mail: smtp (default, everything above) or
# resend, which posts to an HTTP API instead.
#
# Set this to resend only where SMTP is not an option. A great many hosts
# block outbound 25, 465 and 587 — Render does on free instances, and 25 is
# blocked almost everywhere — and there the failure is a connection timeout
# that no correction to the settings above can fix.
#
# resend requires both variables below. With no domain verified at Resend, an
# account may only send from onboarding@resend.dev and only to the address
# that owns it: enough to try, not enough to run.
PORTICO_MAIL_TRANSPORT=smtp
PORTICO_RESEND_API_KEY=
PORTICO_MAIL_FROM=

# The language of a message Portico sends — a reset link, a confirmation —
# to somebody whose own preference and whose tenant's default both say
# nothing. It does not affect the console, which each reader chooses for
# themselves; it is for the text that arrives where there is no menu.
#
# en-US (default) or zh-CN. A tag this build has no messages for is refused
# at startup rather than ignored: setting it meant something, and quietly
# continuing in English is how a setting gets called broken years later.
PORTICO_DEFAULT_LOCALE=en-US

# debug | info | warn | error
PORTICO_LOG_LEVEL=info
